# Backend (Node API) — dibaca saat `pnpm dev:api` / `pnpm start`
# Salin sebagai `.env` di folder `backend/`

SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_CSV_URL/pub?output=csv
SHEETS_WRITE_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
ADMIN_API_TOKEN=
PRODUCT_CACHE_TTL_MS=30000

# Port tempat backend /api/* berjalan
PORT=3001
