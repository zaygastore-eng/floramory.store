# Frontend (Vite) — dibaca saat build/dev di folder `frontend/`
# Salin sebagai `.env.local` di folder `frontend/`

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_WA_NUMBER=6281234567890

# (Opsional) Base URL API ketika frontend dideploy terpisah dari backend.
# Kosongkan (= "") agar memakai origin yang sama (proxy /api saat dev,
# atau URL API di production via reverse proxy).
VITE_API_BASE_URL=
