# Frontend (Vite) — dibaca saat build/dev di folder `frontend/`
# Salin sebagai `.env.local` di folder `frontend/`

VITE_SUPABASE_URL=https://fcevjiflawxmzrccramo.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_WA_NUMBER=6281234567890
VITE_SENTRY_DSN=

# Source-map upload (set as private build environment variables in Vercel/CI).
# Do not use the VITE_ prefix or commit the auth token.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# (Opsional) Base URL Edge Function.
# Kosongkan (= "") untuk memakai jalur same-origin `/api`:
#   - Production: Vercel me-rewrite /api/* -> Supabase functions (vercel.json,
#     ganti URL proyek di sana). Cookie HttpOnly sesi admin jadi same-site.
#   - Development: Vite proxy /api -> Supabase functions (vite.config.ts,
#     memakai VITE_SUPABASE_URL di atas).
# Isi URL langsung hanya bila memakai custom domain functions.
VITE_SUPABASE_FUNCTIONS_URL=