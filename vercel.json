{
  "buildCommand": "pnpm --filter @floramory/frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/produk.ts": {
      "includeFiles": "frontend/dist/index.html"
    },
    "api/seo.ts": {
      "includeFiles": "frontend/dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin",
      "destination": "https://fcevjiflawxmzrccramo.supabase.co/functions/v1/admin"
    },
    {
      "source": "/api/send-preorder",
      "destination": "https://fcevjiflawxmzrccramo.supabase.co/functions/v1/send-preorder"
    },
    {
      "source": "/api/vault-otp",
      "destination": "https://fcevjiflawxmzrccramo.supabase.co/functions/v1/vault-otp"
    },
    {
      "source": "/api/vault-setup",
      "destination": "https://fcevjiflawxmzrccramo.supabase.co/functions/v1/vault-setup"
    },
    {
      "source": "/produk",
      "destination": "/api/produk"
    },
    {
      "source": "/about",
      "destination": "/api/seo?route=about"
    },
    {
      "source": "/shop",
      "destination": "/api/seo?route=shop"
    },
    {
      "source": "/smart-qr-vault",
      "destination": "/api/seo?route=smart-qr-vault"
    },
    {
      "source": "/vault",
      "destination": "/api/seo?route=vault"
    },
    {
      "source": "/((?!assets/.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https: blob:; frame-src 'self' https://open.spotify.com https://www.youtube-nocookie.com https://www.youtube.com https://drive.google.com; connect-src 'self' https://fcevjiflawxmzrccramo.supabase.co wss://fcevjiflawxmzrccramo.supabase.co https://fonts.googleapis.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://wa.me"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}