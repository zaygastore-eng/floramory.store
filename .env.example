# Floramory — Monorepo (frontend + backend)
#
# Variabel lingkungan dipisah per package:
#   - frontend/.env.local   -> variabel VITE_* (dibaca Vite)
#   - backend/.env          -> variabel SHEETS_* / ADMIN_API_TOKEN / PORT (dibaca Node)

# Saat menjalankan frontend (`pnpm dev`), proxy /api menuju backend dev:
# VITE_API_PROXY_TARGET=http://localhost:3001
